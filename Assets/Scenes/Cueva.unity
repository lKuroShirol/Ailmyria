MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188548589}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7888933a35c09554dbf6be477f01eda8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraccionSecuencial
  distanciaInteraccion: 2
  brujita: {fileID: 0}
  indicadorObjeto: {fileID: 469656995}
  panelNPC: {fileID: 441900291115599562}
  textoNPC: {fileID: 3334044525814972941}
  panelBrujita: {fileID: 529899165}
  textoBrujita: {fileID: 529899160}
  reaccionNPC1: {fileID: 3512115310581748109}
  reaccionNPC2: {fileID: 635574590}
  reaccionNPC3: {fileID: 671883736}
  reaccionBrujita1: {fileID: 529899164}
  reaccionBrujita2: {fileID: 529899163}
  reaccionBrujita3: {fileID: 529899162}
  reaccionBrujita4: {fileID: 529899161}
  AhoraNuevaCharla: 1
  NewDialogoNPC1: {fileID: 163414800}
  ActualDialogoNPC: {fileID: 1188548589}
  conversacion:
  - hablaElNPC: 0
    mensaje: "Hola, soy Almiria, tu mam\xE1 me pidi\xF3 que viniera a buscarte, \xBFEst\xE1s
      bien?\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Mi conejita\u2026 "
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFTu conejita?\r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Anoche ella corri\xF3 muy asustada por el huerto y no la encontr\xE9
      en ning\xFAn lado"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Ella debe estar aqu\xED"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: Espero que este bien...
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Yo te ayudar\xE9 a encontrar a tu conejita, pero primero volvamos con
      tu madre, \xBFS\xED? \r\n"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "(Snif). Est\xE1 bien...\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  velocidadEscritura: 0.02
  teclaInteraccion: 19
  CondicionDialogo: 0
  TerminoLaInteraccion: 0
  followNPC: {fileID: 0}
  QuieresQueSiga: 1
  NPCtag: Dalia
