MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1475521271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7888933a35c09554dbf6be477f01eda8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC_DialogoSystem
  distanciaInteraccion: 2
  brujita: {fileID: 863614848}
  indicadorObjeto: {fileID: 1869375657}
  panelNPC: {fileID: 723911381}
  textoNPC: {fileID: 731537083}
  panelBrujita: {fileID: 666616915434527353}
  textoBrujita: {fileID: 3329656161223716371}
  reaccionNPC1: {fileID: 503904617}
  reaccionNPC2: {fileID: 783007127}
  reaccionNPC3: {fileID: 571628638}
  reaccionBrujita1: {fileID: 3201868200928958740}
  reaccionBrujita2: {fileID: 2233305455921975214}
  reaccionBrujita3: {fileID: 814951367815499948}
  reaccionBrujita4: {fileID: 6457375325611462225}
  CondicionDialogo: 0
  AhoraNuevaCharla: 1
  NewDialogoNPC1: {fileID: 493776733}
  ActualDialogoNPC: {fileID: 1475521271}
  conversacion:
  - hablaElNPC: 1
    mensaje: "\xA1Son mis f\xF3sforos!"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "\xA1Muchas gracias!  Ahora podr\xE9 hornear mi pan"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Por cierto, hoy en la madrugada encontr\xE9 esto, te lo doy en agradecimiento
      \r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: '(Joan entrega un fragmento brillante a Almiria) '
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Es mi varita, Muchas gracias Joan!  "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: 'Me alegra que fuera lo que esperabas, con tu permiso, ahora tengo un
      delicioso pan que hornear '
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Seguro ser\xE1 el pan m\xE1s rico de todo el bosque! Puede que
      m\xE1s tarde venga un poco "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Seguro ser\xE1 el pan m\xE1s rico de todo el bosque! Puede que
      m\xE1s tarde venga un poco "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "\xA1Nos vemos Almi!\r\n"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  velocidadEscritura: 0.01
  teclaInteraccion: 19
