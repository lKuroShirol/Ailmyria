--- !u!114 &635253340
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 635253335}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7888933a35c09554dbf6be477f01eda8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC_DialogoSystem
  distanciaInteraccion: 2
  brujita: {fileID: 863614848}
  indicadorObjeto: {fileID: 1729749164}
  panelNPC: {fileID: 723911381}
  textoNPC: {fileID: 731537083}
  panelBrujita: {fileID: 666616915434527353}
  textoBrujita: {fileID: 3329656161223716371}
  reaccionNPC1: {fileID: 503904617}
  reaccionNPC2: {fileID: 783007127}
  reaccionNPC3: {fileID: 571628638}
  reaccionBrujita1: {fileID: 3201868200928958740}
  reaccionBrujita2: {fileID: 2233305455921975214}
  reaccionBrujita3: {fileID: 814951367815499948}
  reaccionBrujita4: {fileID: 6457375325611462225}
  CondicionDialogo: 0
  AhoraNuevaCharla: 0
  NewDialogoNPC1: {fileID: 0}
  ActualDialogoNPC: {fileID: 0}
  conversacion:
  - hablaElNPC: 0
    mensaje: 'Hola, disculpe que le moleste '
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: . . .
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFSe\xF1or? "
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "\xBFQu\xE9 sucede?\r\n"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: '(Sorprendida) '
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Lo siento, no fue mi intenci\xF3n responder as\xED. Estoy un poquiiito
      de mal humor\u2026 \r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Por cierto, no te hab\xEDa visto antes por aqu\xED, imagino que est\xE1s
      de visita, \xBFVerdad?\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Si\u2026 Algo as\xED\r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "La verdad es que he perdido algunas cosas que son muy importantes para
      m\xED\r\n\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Pero...D\xE9jeme presentarme, mi nombre es Almiria, \xBFCu\xE1l es
      el suyo?"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "\xA1Oh, qu\xE9 modales los m\xEDos!, si mam\xE1 me viera me dir\xEDa
      un buen par de cosas\r\n\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: 'Mi nombres es Joan, es un gusto conocerte Almiria '
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "El gusto es m\xEDo, don Joan, d\xEDgame, \xBFa que se debe su mal humor? "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: 'Pasa que ayer por la tarde cuando estaba dando un paseo por el bosque. '
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Vino una fuerte brisa la cu\xE1l se llev\xF3 volando mi caja de f\xF3sforos
      a alg\xFAn lado"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Intent\xE9 buscarla pero...  "
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: No la encuentro...
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: Sin mi caja no puedo prender mi horno de pan y-
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: Sisisi. Fosforos, yo buscar
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Yo ayudarte!"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "(Otra vez me ofrec\xED a ayudar impulsivamente, \xBFPor qu\xE9  ser\xE1
      que no puedo evitarlo?)\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Excelente. Oye creo que ayer encontr\xE9 algo brillante y lo dej\xE9
      en alg\xFAn lado "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Mientras me ayudas, pensar\xE9 en d\xF3nde fue que lo dej\xE9 ..."
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Muchas gracias!, yo tambi\xE9n me pondr\xE9 a buscar, volver\xE9
      tan pronto como me ruga la panza"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: " Gracias a... (\xBFQuerr\xE1 pan gratis?)"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 1
  velocidadEscritura: 0.01
  teclaInteraccion: 19
