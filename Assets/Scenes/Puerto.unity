--- !u!114 &1422431941
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1422431940}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7888933a35c09554dbf6be477f01eda8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraccionSecuencial
  distanciaInteraccion: 3
  brujita: {fileID: 1975192535}
  indicadorObjeto: {fileID: 1103938717}
  panelNPC: {fileID: 8513808520666680752}
  textoNPC: {fileID: 7438397406651457369}
  panelBrujita: {fileID: 1597090052}
  textoBrujita: {fileID: 1597090051}
  reaccionNPC1: {fileID: 6973399256544504931}
  reaccionNPC2: {fileID: 2158349249128157656}
  reaccionNPC3: {fileID: 8673736123978855372}
  reaccionBrujita1: {fileID: 2010319502}
  reaccionBrujita2: {fileID: 162568814}
  reaccionBrujita3: {fileID: 1371331262}
  reaccionBrujita4: {fileID: 2077550976}
  CondicionDialogo: 0
  conversacion:
  - hablaElNPC: 0
    mensaje: "Hola se\xF1or"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Hola, es la primera vez que veo tu rostro, dime, encantado peque\xF1a,
      \xBFCu\xE1l es tu nombre?\r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Me llamo Almiria, \xBFCu\xE1l es el suyo? \r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: ' Mi nombre es Barei, es un placer conocerte Almiria '
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBF\xA1Es usted un anciano!? pero se ve muy joven "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Gracias por tu lindo comentario, parece que me he cuidado bien estos
      60 a\xF1os.\r\n "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: 'La verdad es que ni se notan '
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Ja ja ja\u2026 Tu si que sabes c\xF3mo halagar a viejitos como yo. "
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Cu\xE9ntame, Almiria, \xBFHay algo que este anciano pueda hacer por
      t\xED?\r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Estoy buscando unos fragmentos brillantes. \xBFDe casualidad no ha
      visto algo parecido?\r\n\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Ahora que lo mencionas, creo que v\xED algo brillando...\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFQu\xE9 cosa?"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: El sol
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: ._.
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: 'Bueno ya enserio. No pensaba pedirte algo a cambio, pero si me ofreces
      tu ayuda...

'
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: 'Hablad Sabio anciano

'
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Ver\xE1s\u2026 "
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Hace alrededor de 1 a\xF1o... Estoy buscando una fotograf\xEDa que
      perd\xED..."
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "No es una fotograf\xEDa cualquiera, es el \xFAnico recuerdo que tengo
      de mis padres "
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: 'Estoy perdiendo la memoria... '
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: '... '
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFSon sus padres quienes reposan bajo el gran \xE1rbol, verdad?"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: Veo que te diste cuenta
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xA1Tambi\xE9n su l\xE1pida est\xE1 muy limpia! \xA1Y las flores est\xE1n
      m\xE1s vivas que nunca! \r\n"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Los amaba mucho se\xF1or"
