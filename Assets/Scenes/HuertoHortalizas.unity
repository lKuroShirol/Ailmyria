  m_Script: {fileID: 11500000, guid: 7888933a35c09554dbf6be477f01eda8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraccionSecuencial
  distanciaInteraccion: 2
  brujita: {fileID: 0}
  indicadorObjeto: {fileID: 172524342}
  panelNPC: {fileID: 2139899860}
  textoNPC: {fileID: 2139899856}
  panelBrujita: {fileID: 529899165}
  textoBrujita: {fileID: 529899160}
  reaccionNPC1: {fileID: 2139899859}
  reaccionNPC2: {fileID: 2139899858}
  reaccionNPC3: {fileID: 2139899857}
  reaccionBrujita1: {fileID: 529899164}
  reaccionBrujita2: {fileID: 529899163}
  reaccionBrujita3: {fileID: 529899162}
  reaccionBrujita4: {fileID: 529899161}
  AhoraNuevaCharla: 0
  NewDialogoNPC1: {fileID: 0}
  ActualDialogoNPC: {fileID: 0}
  conversacion:
  - hablaElNPC: 0
    mensaje: "Hol\u2026"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Por favor, ay\xFAdame \r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Mi hija, mi hija\u2026\r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFQu\xE9 sucede? \r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "No puedo encontrar a mi hija desde esta ma\xF1ana \r\n"
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "He revisado en todos los lugares. A excepci\xF3n de la cueva\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "\xBFLa cueva? \r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 1
  - hablaElNPC: 1
    mensaje: "Esta hac\xEDa la derecha de nuestro huerto, pero no puedo ver nada
      dentro\r\n"
    usarReaccion1: 0
    usarReaccion2: 0
    usarReaccion3: 1
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: Por favor, ayuda a mi hija, debe estar muy asustada
    usarReaccion1: 1
    usarReaccion2: 0
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 0
    mensaje: "Yo la traer\xE9 de vuelta, no se preocupe, espere aqu\xED por favor
      y mantenga la calma\r\n"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  - hablaElNPC: 1
    mensaje: "Muchas gracias, eres un sol. Juro que te recompensar\xE9"
    usarReaccion1: 0
    usarReaccion2: 1
    usarReaccion3: 0
    usarReaccion4: 0
  velocidadEscritura: 0.02
  teclaInteraccion: 19
  CondicionDialogo: 0
  TerminoLaInteraccion: 0
  followNPC: {fileID: 0}
  QuieresQueSiga: 0
  NPCtag: 
